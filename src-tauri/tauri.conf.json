{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disq Studio",
  "version": "1.0.0",
  "identifier": "com.volti.disk-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Disq Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 620,
        "decorations": true,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0D0E11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDQkRFQUMyNzZEMzYwRDkKUldUWllOTjJ3dXE5TElCS0hmUk1OQi9UTDVrZ2JSb1ZMWmRDQUtxeHVXbDlwZU04VmpHb3Z2Qk8K",
      "endpoints": ["https://github.com/Voltiq/Disq-Studio/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Voltiq",
    "copyright": "© 2026 Voltiq",
    "category": "Utility",
    "shortDescription": "See what's filling your drive",
    "longDescription": "Disq Studio scans a drive or folder on every core and draws it as a treemap, then helps you find duplicates and junk and clear them out safely.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "../installer/header.bmp",
        "sidebarImage": "../installer/sidebar.bmp",
        "displayLanguageSelector": false,
        "installerHooks": "../installer/hooks.nsh"
      }
    }
  }
}
